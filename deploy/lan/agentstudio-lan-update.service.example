[Unit]
Description=Agent Studio LAN outbound GitHub CI-gated updater (no inbound SSH)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 /usr/local/libexec/agentstudio-lan/pull-update.py --auto
TimeoutStartSec=25min
# Give the trusted controller time to recover old code on SIGTERM/timeout.
TimeoutStopSec=5min
KillMode=control-group
UMask=0077
# Root release orchestrator needs CAP_SETUID/CAP_SETGID to drop into the builder.
# Only the trusted root-owned Python controller runs here; downloaded build
# commands run through setpriv as agentstudio-build with --no-new-privs.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# pnpm also needs its isolated builder HOME/cache writable.
# nginx -t opens /www/server/nginx/logs/nginx.pid and BaoTa's
# /www/wwwlogs/nginx_error.log (plus tcp-error.log) during validation.
# Grant only these log directories, not all of /www or /run.
# After PocketBase/Worker stop, WAL/SHM may disappear. SQLite mode=ro
# still needs this exact directory writable to reopen the offline WAL DB.
# Keep the root controller's PRAGMA query_only and idle/unchanged-data gates.
ReadWritePaths=/srv/agent-studio-lan /var/backups/agentstudio-lan /var/lib/agentstudio-build /www/server/nginx/logs /www/wwwlogs /var/lib/agentstudio-lan/pb_data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
