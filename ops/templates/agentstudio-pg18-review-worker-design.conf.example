# SOURCE EXAMPLE ONLY. Do not install, enable or start a service.
# Review with agent-assessment-worker.service.example, then place only under
# agentstudio-pg18-review-worker.service.d/ after separate runtime approval.
# The unchanged base ExecStart remains the original --preflight worker.
[Service]
LoadCredential=design-worker.secret:/root/.agentstudio-pg18-secrets/design-worker.secret
Environment=AGENT_STUDIO_PG18_DESIGN_EXECUTION_ENABLED=false
Environment=AGENT_STUDIO_PG18_DESIGN_EXECUTION_APPROVED=REVIEW_REQUIRED
