# REVIEW ONLY. Private Broker read-only preflight; do not install or enable.
# No --serve, paid execution flags or [Install] section.
[Unit]
Description=Agent Studio PG18 knowledge index Broker read-only preflight
After=network-online.target

[Service]
Type=oneshot
User=agentstudio-pg18-kb-broker
DynamicUser=yes
WorkingDirectory=/opt/agentstudio-pg18-api-preflight-v1/services/pg-api
ExecStart=/opt/agentstudio-node24/bin/node --experimental-strip-types /opt/agentstudio-pg18-api-preflight-v1/services/pg-api/src/knowledge-index-service.ts --preflight broker
Restart=no
UMask=0077
LimitCORE=0
LoadCredential=index.secret:/root/.agentstudio-pg18-secrets/knowledge-index-broker.secret
LoadCredential=broker.secret:/root/.agentstudio-pg18-secrets/model-broker.secret
LoadCredential=model-encryption.secret:/root/.agentstudio-pg18-secrets/model-encryption.secret
LoadCredential=dispatch-ca.pem:/root/.agentstudio-pg18-secrets/knowledge-index-ca.pem
LoadCredential=dispatch-server.pem:/root/.agentstudio-pg18-secrets/knowledge-index-server.pem
LoadCredential=dispatch-server.key:/root/.agentstudio-pg18-secrets/knowledge-index-server.key
Environment=AGENT_STUDIO_PG_KNOWLEDGE_INDEX_REVIEWED=true
Environment=AGENT_STUDIO_PG_KNOWLEDGE_INDEX_CLIENT_FINGERPRINT=REPLACE_WITH_REVIEWED_INDEX_WORKER_SHA256
Environment=AGENT_STUDIO_PG_PILOT_ENABLED=true
Environment=AGENT_STUDIO_PG_BAOTA18_ENABLED=true
Environment=AGENT_STUDIO_PG_BAOTA18_TARGET_CONFIRMED=true
Environment=AGENT_STUDIO_PG_HOST=127.0.0.1
Environment=AGENT_STUDIO_PG_PORT=5333
Environment=AGENT_STUDIO_PG_DATABASE=agent_studio
Environment=AGENT_STUDIO_PG_USER=agentstudio_stage_login
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
CapabilityBoundingSet=
AmbientCapabilities=
