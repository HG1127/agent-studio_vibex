{
  "name": "agent-studio-desktop",
  "version": "0.1.0-preview.31",
  "private": true,
  "description": "Agent Studio Windows desktop client",
  "author": "Agent Studio",
  "main": "main.cjs",
  "scripts": {
    "build": "electron-builder --win --x64 --dir && node build-launcher.mjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.agentstudio.desktop",
    "productName": "Agent Studio",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../.tmp/desktop-output"
    },
    "files": [
      "main.cjs",
      "single-instance.cjs",
      "policy.cjs",
      "update-core.cjs",
      "update-helper.cjs",
      "update-controller.cjs",
      "update-trust.json",
      "company-https.cjs",
      "trust/**",
      "release-history.json",
      "ui/**",
      "build-info.json",
      "!node_modules/**/*",
      "startup-health.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      },
      {
        "from": "../.tmp/desktop-connector",
        "to": "connector"
      },
      {
        "from": "gateway.mjs",
        "to": "connector/app/desktop/gateway.mjs"
      },
      {
        "from": "services.mjs",
        "to": "connector/app/desktop/services.mjs"
      },
      {
        "from": "pairing.mjs",
        "to": "connector/app/desktop/pairing.mjs"
      },
      {
        "from": "computer.mjs",
        "to": "connector/app/desktop/computer.mjs"
      },
      {
        "from": "../.tmp/desktop-update-guard",
        "to": "update-guard"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "ui/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AgentStudio-Desktop-${version}-win-x64.exe"
    }
  }
}
